{
  "name": "paul-skills",
  "version": "1.4.0",
  "private": true,
  "description": "Paul’s skill library with source tracking and human-reviewed improvements",
  "repository": {
    "type": "git",
    "url": "https://github.com/reach0908/paul-skills"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "check": "npm run check-plugin-version && python3 scripts/check-skills.py && npm test",
    "test": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^3.0.3"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "^22.11 || ^24 || >=26",
    "npm": ">=10.9.0"
  }
}
