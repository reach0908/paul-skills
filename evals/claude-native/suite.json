  "groups": {
    "group-with-without": {
      "ablation": "with-without",
      "allowTools": [
        "Write",
        "Edit"
      ],
      "comparison": "The task is meaningful without the plugin, so the no-plugin arm measures added value."
    },
    "group-single-arm": {
      "ablation": "none",
      "allowTools": [
        "Bash(git:*)"
      ],
      "comparison": "n/a: explicit invocation and its routing boundary do not exist without the plugin."
    },
    "group-edit-with-without": {
      "ablation": "with-without",
      "allowTools": [
        "Edit",
        "Write"
      ],
      "comparison": "The task is meaningful without the plugin; the graders forbid new or unrelated files."
    },
    "group-code-with-without": {
      "ablation": "with-without",
      "allowTools": [
        "Edit",
        "Write",
        "Bash(node:*)",
        "Bash(npm:*)",
        "Bash(git:*)"
      ],
      "comparison": "The task is meaningful without the plugin; edits and node, npm and git commands are allowed."
    }
  },
